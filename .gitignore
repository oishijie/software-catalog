# ---------- 工作区数据（含部署凭据记录，禁止入仓） ----------
.workbuddy/

# ---------- 依赖 ----------
node_modules/

# ---------- Nuxt 构建 / 开发产物 ----------
.output/
.nuxt/
.nitro/
.cache/
dist/

# ---------- Cloudflare / wrangler ----------
.wrangler/

# ---------- 环境变量 ----------
.env
.env.*
!.env.example
# wrangler 本地密钥（wrangler pages dev / d1 execute 读取）
.dev.vars
.dev.vars.*

# ---------- SQLite ----------
# catalog.db 是派生产物，可由 data/crawl/ 下的抓取结果重新导入：
#   工具脚本见 tools/import-json.mjs、tools/import-details.mjs
# 若希望把数据随仓库一起携带，注释掉下面两行即可。
data/catalog.db
data/catalog.db-*

# D1 导入分片：由 catalog.db 经 tools/export-d1-sql.mjs 生成，可随时重建
data/d1/

# ---------- 临时文件 ----------
*.bak
*.tmp
*.log
pnpm-debug.log*
npm-debug.log*

# ---------- 编辑器 / 系统 ----------
.idea/
.DS_Store
Thumbs.db
desktop.ini
